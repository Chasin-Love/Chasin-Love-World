{
  "name": "chasin-love-world",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "audit:arch": "tsx scripts/audit-architecture.ts",
    "smoke": "tsx scripts/smoke.ts",
    "prod:smoke": "tsx scripts/prod-smoke.ts",
    "verify": "npm run typecheck && tsx scripts/round16-gauntlet.ts && tsx scripts/round17-gauntlet.ts && tsx scripts/round18-kamui-gauntlet.ts && tsx scripts/round63-void-gauntlet.ts && tsx scripts/round72-stage-arrival-gauntlet.ts && tsx scripts/round73-throat-gauntlet.ts && tsx scripts/smoke.ts && npm run prod:smoke",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "serve": "esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs && NODE_ENV=production node dist/server.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "express": "^5.2.1",
    "framer-motion": "^11.16.1",
    "hash-wasm": "^4.12.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.294.0",
    "monaco-editor": "^0.56.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^5.0.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "dompurify": "^3.4.13"
  }
}
